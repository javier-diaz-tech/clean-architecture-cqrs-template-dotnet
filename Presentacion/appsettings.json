{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "ArquitecturaBase.Api",
    "EnableConsoleExporter": true,
    "EnableOtlpExporter": false
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
  "Persistence": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ArquitecturaBaseDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Swagger": {
    "Enabled": true
  }

  //Para postgresql, descomentar la siguiente sección y comentar la sección de arriba
  //"Persistence": {
  //  "Provider": "PostgreSql"
  //},
  //"ConnectionStrings": {
  //  "DefaultConnection": "Host=localhost;Port=5432;Database=arquitecturabase;Username=postgres;Password=CAMBIAR_EN_CONFIGURACION_LOCAL"
  //}
}
